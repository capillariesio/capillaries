{
  "handler_executable_type": "capi_daemon",
  "cassandra": {
    "hosts": [
      "127.0.0.1"
    ],
    "port": 9042,
    "username": "cassandra",
    "password": "cassandra",
    "keyspace_replication_config": "{ 'class' : 'NetworkTopologyStrategy', 'datacenter1' : 1 }",
    "writer_workers": 1,
    "num_conns": 2,
    "timeout": 5000,
    "connect_timeout": 1000
  },
  "amqp10_for_rabbitmq4": {
    "url": "amqp://guest:guest@127.0.0.1:5672/",
    "address": "/queues/capidaemon",
    "retry_method": "reject"
  },
  "amqp10_for_activemq_artemis": {
    "url": "amqp://artemis:artemis@127.0.0.1:5672/",
    "address": "capillaries",
    "retry_method": "release"
  },
  "amqp10_for_activemq_classic": {
    "url": "amqp://guest:guest@127.0.0.1:5672/",
    "address": "capillaries",
    "retry_method": "reject"
  },
  "capimq_client_for_capimq_experimental":{
    "url":"http://localhost:7654",
    "heartbeat_interval": 1000
  },
  "mq_type":"amqp10",
  "amqp10": {
    "url": "amqp://artemis:artemis@127.0.0.1:5672/",
    "address": "capillaries",
    "retry_method": "release"
  },
  "capimq_client":{
    "url":"http://localhost:7654",
    "heartbeat_interval": 1000
  },
  "access_policy": {
    "allowed_schemes": ["file", "http", "https", "s3"],
    "allow_private_hosts": true,
    "input_paths": [
      "/tmp/capi_in",
      "file:///tmp/capi_cfg",
      "https://raw.githubusercontent.com/capillariesio/capillaries/",
      "s3://$CAPILLARIES_AWS_TESTBUCKET/capi_in/",
      "s3://$CAPILLARIES_AWS_TESTBUCKET/capi_cfg/"
    ],
    "output_paths": [
      "/tmp/capi_out",
      "s3://$CAPILLARIES_AWS_TESTBUCKET/capi_out/"
    ]
  },
  "custom_processors": {
    "py_calc": {
      "python_interpreter_path": "python3",
      "python_interpreter_params": [
        "-u",
        "-"
      ]
    },
    "tag_and_denormalize": {}
  },
  "daemon": {
    "message_verify": {
      "mode": "permissive",
      "public_keys": {"dummy-key-do-not-use-in-production-see-msgsig-test-go-for-details": "5tqw/Q6L9+sCUljNDTG3mhHY+vOOVWKI0EsPop8OSkg="}
    },
    "thread_pool_size": 2
  },
  "log": {
    "level": "debug",
    "prometheus_exporter_port": 9201
  }
}